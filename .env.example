# Databricks Workspace Configuration
# Copy this file to .env and fill in your actual credentials
# .env is excluded from git for security - never commit credentials!

# Databricks Host (workspace URL)
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com

# Databricks Personal Access Token
DATABRICKS_TOKEN=your_personal_access_token_here

# Optional: Databricks workspace ID
# DATABRICKS_WORKSPACE_ID=your_workspace_id
